rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'kaytrut426@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function okText(t, max) {
      return t is string && t.size() >= 3 && t.size() <= max
        && !t.matches('(?s).*[0-9][0-9 /-]{6,}[0-9].*')
        && !t.lower().matches('(?s).*(https?://|www[.]|@).*')
        && !t.lower().matches('(?s).*(hure|fotze|schwuchtel|spast|missgeburt|nazi|hurensohn|umbringen).*');
    }

    function textPost(d) {
      return d.keys().hasOnly(['t', 'color', 'font', 'rot', 'ts'])
        && okText(d.t, 120)
        && d.color in ['ink', 'red', 'blue', 'green', 'silver']
        && d.font in ['hand', 'marker', 'scrawl'];
    }

    function drawPost(d) {
      return d.keys().hasOnly(['img', 'rot', 'ts'])
        && d.img is string && d.img.size() <= 150000
        && d.img.matches('data:image/png;base64,[A-Za-z0-9+/=]+');
    }

    match /walls/{wall}/posts/{id} {
      allow read: if true;
      allow create: if (textPost(request.resource.data) || drawPost(request.resource.data))
        && request.resource.data.rot is number
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin();
    }

    match /walls/{wall}/replies/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['p', 't', 'ts'])
        && request.resource.data.p is string
        && okText(request.resource.data.t, 60)
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin();
    }

    match /walls/{wall}/likes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['p'])
        && id.matches(request.resource.data.p + '_[a-zA-Z0-9]{8,40}');
      allow delete: if isAdmin();
    }

    match /walls/{wall}/reports/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['p'])
        && id.matches(request.resource.data.p + '_[a-zA-Z0-9]{8,40}');
      allow delete: if isAdmin();
    }

    function okName(n) {
      return n is string && n.size() >= 2 && n.size() <= 12
        && n.matches('[A-Za-zÄÖÜäöüß0-9 ._-]+')
        && !n.lower().matches('.*(hure|fotze|schwuchtel|spast|missgeburt|nazi|hurensohn|nutte|wichser|fick).*');
    }

    match /walls/{wall}/games/{game}/scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'day', 'ts'])
        && okName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.day is string
        && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.ts == request.time
        && ((game == 'fang' && request.resource.data.score >= 0 && request.resource.data.score <= 300)
          || (game == 'reflex' && request.resource.data.score >= 100 && request.resource.data.score <= 3000));
      allow delete: if isAdmin();
    }
  }
}
